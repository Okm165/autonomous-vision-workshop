    def compute_triangle_normals(self) -> TriangleMesh: ...
    def paint_uniform_color(self, color: NDArray[np.float64]) -> TriangleMesh: ...
    def translate(self, translation: NDArray[np.float64]) -> TriangleMesh: ...
    def rotate(
