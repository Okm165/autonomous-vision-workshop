from collections.abc import Iterator
from typing import Any

import numpy as np
from numpy.typing import NDArray

__all__ = ["PointCloud", "TriangleMesh"]

class Vector3dVector:
    """A `(N, 3)` float64 matrix passed through Open3D's pybind boundary.

    Open3D stores point/mesh attributes in this type; `np.asarray` on it
    yields the backing `(N, 3)` array, and `len` gives the row count.
    """

    def __init__(self, value: NDArray[np.float64] | list[list[float]]) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[NDArray[np.float64]]: ...
    def __getitem__(self, index: int) -> NDArray[np.float64]: ...

class Vector3iVector:
    """A `(N, 3)` int32 matrix of triangle indices."""

    def __init__(self, value: NDArray[np.int32] | list[list[int]]) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[NDArray[np.int32]]: ...
    def __getitem__(self, index: int) -> NDArray[np.int32]: ...

class Geometry3D:
    def is_empty(self) -> bool: ...
    def dimension(self) -> int: ...

class PointCloud(Geometry3D):
    def __init__(self) -> None: ...
    points: Vector3dVector
    normals: Vector3dVector
    colors: Vector3dVector
    def has_points(self) -> bool: ...
    def has_normals(self) -> bool: ...
    def has_colors(self) -> bool: ...

class TriangleMesh(Geometry3D):
    def __init__(self) -> None: ...
    vertices: Vector3dVector
